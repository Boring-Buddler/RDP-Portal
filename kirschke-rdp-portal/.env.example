# Kirschke RDP Workstation Portal Configuration
# Copy this file to .env and modify for your environment

# =============================================================================
# Application Settings
# =============================================================================

# Application version (read-only, set by package)
APP_VERSION=0.1.0

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=true

# =============================================================================
# Microsoft Entra ID Configuration (Phase 2+)
# =============================================================================

# Azure AD Tenant ID
TENANT_ID=your-tenant-id-here

# Application (Client) ID for the portal app
PORTAL_CLIENT_ID=your-portal-client-id-here

# Application (Client) ID for the agent (app-only auth)
AGENT_CLIENT_ID=your-agent-client-id-here

# Authority URL
AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# Redirect URI for portal app
PORTAL_REDIRECT_URI=http://localhost:8000/auth/callback

# Scopes required by the portal app
PORTAL_SCOPES=User.Read,Group.ReadAll,Sites.Read.All,Sites.ReadWrite.All

# =============================================================================
# SharePoint Configuration (Phase 2+)
# =============================================================================

# SharePoint site ID (GUID)
SHAREPOINT_SITE_ID=your-sharepoint-site-id-here

# SharePoint site URL
SHAREPOINT_SITE_URL=https://yourdomain.sharepoint.com/sites/yoursite

# List names
SHAREPOINT_WORKSTATIONS_LIST=RDP_Workstations
SHAREPOINT_SESSIONS_LIST=RDP_SessionEvents
SHAREPOINT_COMMANDS_LIST=RDP_AdminCommands
SHAREPOINT_ACCESS_RULES_LIST=RDP_AccessRules

# =============================================================================
# Workstation Agent Configuration (Phase 3+)
# =============================================================================

# Agent poll interval in seconds
AGENT_POLL_INTERVAL=30

# Agent certificate thumbprint (for app-only auth)
AGENT_CERT_THUMBPRINT=your-certificate-thumbprint-here

# Certificate store name (typically "My" or "Root")
AGENT_CERT_STORE=My

# =============================================================================
# RDP Settings
# =============================================================================

# Default RDP settings
RDP_DEFAULT_SCREEN_MODE=windowed
RDP_DEFAULT_RESOLUTION=1920x1080
RDP_DEFAULT_USE_ALL_MONITORS=false
RDP_DEFAULT_REDIRECT_CLIPBOARD=true
RDP_DEFAULT_REDIRECT_DRIVES=false
RDP_DEFAULT_REDIRECT_PRINTERS=false
RDP_DEFAULT_REDIRECT_AUDIO=false

# Entra SSO enabled by default
RDP_DEFAULT_ENTRA_SSO=false

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=rdp_portal.log

# Max log file size in bytes
LOG_MAX_SIZE=10485760  # 10MB

# Number of backup log files
LOG_BACKUP_COUNT=5

# =============================================================================
# Security Settings
# =============================================================================

# Command expiry time in minutes
COMMAND_EXPIRY_MINUTES=5

# Session sync interval in seconds
SESSION_SYNC_INTERVAL=60

# Max failed login attempts before lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# User Groups (Entra ID)
# =============================================================================

# Group ID for regular users
RDP_PORTAL_USERS_GROUP_ID=your-users-group-id-here

# Group ID for administrators
RDP_PORTAL_ADMINS_GROUP_ID=your-admins-group-id-here

# =============================================================================
# Network Settings
# =============================================================================

# Proxy configuration (if needed)
# HTTP_PROXY=http://your-proxy:8080
# HTTPS_PROXY=http://your-proxy:8080

# Connection timeout in seconds
CONNECTION_TIMEOUT=30

# Read timeout in seconds
READ_TIMEOUT=60

# =============================================================================
# Temporary Files
# =============================================================================

# Directory for temporary RDP files
TEMP_RDP_DIR=

# Cleanup old RDP files after hours (0 = never)
CLEANUP_RDP_FILES_AFTER_HOURS=24
