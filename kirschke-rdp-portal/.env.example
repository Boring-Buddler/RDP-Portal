# Kirschke RDP Workstation Portal – Umgebungsvariablen
#
# Reine Referenz: .env-Dateien werden NICHT automatisch geladen. Echte
# Umgebungsvariablen in PowerShell oder in den Windows-Benutzereinstellungen setzen.
#
# Diese Datei listet nur Variablen, die der Code tatsächlich liest. Frühere
# Fassungen dokumentierten ein Dutzend Einstellungen, die nirgends ausgewertet
# wurden (MAX_FAILED_LOGIN_ATTEMPTS, CLEANUP_RDP_FILES_AFTER_HOURS,
# LOG_MAX_SIZE, APP_VERSION, TEMP_RDP_DIR und weitere). Sie sind entfernt;
# die betroffenen Werte stehen jetzt als Konstanten im Code:
#
#   Adminzugang: Fehlversuche/Sperre  -> portal_app/services/admin_security.py
#   Alte .rdp-Dateien aufräumen       -> portal_app/rdp/generator.py (cleanup_old)
#   Logrotation des Portals           -> portal_app/app.py (configure_logging)
#   Ereignisprotokoll-Rotation        -> portal_app/services/local_store.py
#   Programmversion                   -> shared/version.py
#
# =============================================================================
# Aktiver lokaler Pilotbetrieb
# =============================================================================

# local (Standard) oder active_directory
RDP_PORTAL_DIRECTORY_MODE=local

# Nur im AD-Modus wirksam: erlaubt zusätzlich den lokalen Passwort-Fallback.
RDP_PORTAL_ALLOW_TEST_ADMIN_PASSWORD=false

# Windows-Gruppe, die im AD-Modus den Adminbereich freischaltet.
# RDP_PORTAL_ADMIN_GROUP=RDP-Portal-Admins

# =============================================================================
# Nur für den Agenten auf dem Ziel-PC
# =============================================================================
# Das Portal erbt AGENT_STATUS_DIR nicht; den Datei-Fallback pro Maschine unter
# Maschinen -> Details einstellen.

# AGENT_CONFIG_PATH=C:\ProgramData\KirschkeRDPAgent\agent-config.json
# AGENT_STATUS_DIR=C:\RDP-Portal-Daten\agenten-status
# WORKSTATION_ID=WS-001
# AGENT_PUBLISH_LOCAL_STATUS=true
# AGENT_LOG_FILE=C:\ProgramData\KirschkeRDPAgent\agent.log
# AGENT_LOG_LEVEL=INFO
# Überschreibt die Version aus shared/version.py – normalerweise nicht setzen.
# AGENT_VERSION=

# =============================================================================
# Noch nicht integrierte Cloud-Module (Phase 2/3)
# =============================================================================
# Diese Variablen werden ausschließlich von den Modulen gelesen, die der aktive
# Programmstart nicht erreicht. Siehe docs/phase2-status.md: der Entra-Token-Cache
# ist in der vorliegenden Fassung nachweislich nicht lauffähig. Das Setzen dieser
# Werte aktiviert keinen Cloudbetrieb.

# -- Microsoft Entra ID ------------------------------------------------------
# TENANT_ID=
# PORTAL_CLIENT_ID=
# AUTHORITY=https://login.microsoftonline.com/<tenant-id>
# PORTAL_REDIRECT_URI=http://localhost:8000/auth/callback
# PORTAL_SCOPES=User.Read,Group.ReadAll
# ENTRA_CACHE_PATH=
# RDP_PORTAL_USERS_GROUP_ID=
# RDP_PORTAL_ADMINS_GROUP_ID=

# SharePoint und Microsoft Graph sind seit 0.9.0 / Agent 1.7.0 entfernt.
# Gemeinsame Daten laufen ausschließlich über Netzwerkfreigaben und die Pipe
# der Agenten; SHAREPOINT_*-, GRAPH_*- und AGENT_CERT_*-Variablen werden nicht
# mehr gelesen.

# -- Agent-Ereignisablage (Phase 3) -----------------------------------------
# AGENT_LOG_DIR=
# AGENT_PERSIST_EVENTS=false

# =============================================================================
# Entwicklung
# =============================================================================

# Ausführlichere Ausgaben in den Cloud-Modulen.
DEBUG=false
